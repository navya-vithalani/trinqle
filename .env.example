# Web Push VAPID keys (generate once via: node -e "const c=require('crypto');const e=c.createECDH('prime256v1');e.generateKeys();console.log('PUBLIC='+e.getPublicKey().toString('base64url'));console.log('PRIVATE='+e.getPrivateKey().toString('base64url'))")
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Cron authentication bearer secret (required by /api/send)
CRON_SECRET=

# Upstash KV / Redis REST credentials (created when linking Upstash Redis in Vercel)
KV_REST_API_URL=
KV_REST_API_TOKEN=
