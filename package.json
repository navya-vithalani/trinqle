{
  "name": "trinqle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run generate-pwa-assets",
    "dev": "vite",
    "prebuild": "npm run generate-pwa-assets",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate-pwa-assets": "pwa-assets-generator && node -e \"const fs=require('fs'); ['pwa-64x64.png','pwa-192x192.png','pwa-512x512.png','maskable-icon-512x512.png','apple-touch-icon-180x180.png','favicon.ico'].forEach(f => { if(fs.existsSync('public/icons/'+f)) fs.copyFileSync('public/icons/'+f, 'public/'+f); });\" && node -e \"import('sharp').then(({default:s}) => s('public/icons/badge.svg').resize(96,96).png().toFile('public/badge-96x96.png'))\""
  },
  "dependencies": {
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/fredoka": "^5.1.1",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dompurify": "^3.5.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.0.9",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vite-pwa/assets-generator": "^0.2.6",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.1.1",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "sharp": "^0.33.5"
  }
}
